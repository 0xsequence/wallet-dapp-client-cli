{
  "name": "@0xsequence/dapp-client-cli",
  "version": "0.1.5",
  "private": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "dapp-client-cli": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./passphrase": {
      "types": "./dist/passphrase.d.ts",
      "import": "./dist/passphrase.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./redirect": {
      "types": "./dist/redirect.d.ts",
      "import": "./dist/redirect.js"
    },
    "./fee-utils": {
      "types": "./dist/fee-utils.d.ts",
      "import": "./dist/fee-utils.js"
    },
    "./explicit-session-config": {
      "types": "./dist/explicit-session.config.d.ts",
      "import": "./dist/explicit-session.config.js"
    },
    "./permissions/types": {
      "types": "./dist/permissions/types.d.ts",
      "import": "./dist/permissions/types.js"
    },
    "./permissions/helpers": {
      "types": "./dist/permissions/helpers.d.ts",
      "import": "./dist/permissions/helpers.js"
    },
    "./permissions/constants": {
      "types": "./dist/permissions/constants.d.ts",
      "import": "./dist/permissions/constants.js"
    },
    "./permissions/fee-options": {
      "types": "./dist/permissions/fee-options.d.ts",
      "import": "./dist/permissions/fee-options.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "tsc && node dist/index.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@0xsequence/dapp-client": "3.0.0-beta.17",
    "dotenv": "^17.2.3",
    "ox": "^0.9.17",
    "undici": "^7.6.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@types/yargs": "^17.0.35",
    "typescript": "^5.9.3",
    "viem": "^2.38.0"
  }
}
